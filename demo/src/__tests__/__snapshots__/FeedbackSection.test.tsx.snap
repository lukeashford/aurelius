                          aria-label="Attach file"
                          class="p-3 text-silver/60 hover:text-silver transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                          type="button"
                        >
                          <svg
                            aria-hidden="true"
                            class="lucide lucide-paperclip w-5 h-5"
                            fill="none"
                            height="24"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                            width="24"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path
                              d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"
                            />
                          </svg>
                        </button>
                        <input
                          aria-hidden="true"
                          class="hidden"
                          multiple=""
                          type="file"
                        />
                        <textarea
                          class="flex-1 bg-transparent text-white placeholder:text-silver/60 py-3 pr-12 resize-none outline-none min-h-12"
                          placeholder="Send a message..."
                          rows="1"
                          style="max-height: 200px;"
                        />
                        <button
                          aria-label="Send message"
                          class="absolute right-2 bottom-2 p-2 transition-colors duration-200 text-silver/40 cursor-not-allowed"
                          disabled=""
                          type="button"
                        >
                          <svg
                            aria-hidden="true"
                            class="lucide lucide-send w-5 h-5"
                            fill="none"
                            height="24"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                            width="24"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path
                              d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"
                            />
                            <path
                              d="m21.854 2.147-10.94 10.939"
                            />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  class="transition-all duration-500 ease-in-out flex-zero"
                />
              </div>
            </div>
            <div
              class="h-full w-9 bg-charcoal/80 flex flex-col items-center shrink-0 py-2 border-l border-ash/40"
            >
              <div
                class="flex flex-col items-center gap-1"
              >
                <button
                  aria-label="Artifacts"
                  aria-pressed="false"
                  class="w-8 h-8 flex items-center justify-center transition-colors duration-150 text-silver hover:text-white hover:bg-ash/20"
                >
                  <span
                    class="w-4 h-4 block"
                  >
                    <svg
                      fill="currentColor"
                      viewBox="0 0 20 20"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        clip-rule="evenodd"
                        d="M2 4.5A1.5 1.5 0 013.5 3h13A1.5 1.5 0 0118 4.5v11a1.5 1.5 0 01-1.5 1.5h-13A1.5 1.5 0 012 15.5v-11zM4 5v1h1V5H4zm2 0v1h1V5H6zm7 0v1h1V5h-1zm2 0v1h1V5h-1zM4 14v1h1v-1H4zm2 0v1h1v-1H6zm7 0v1h1v-1h-1zm2 0v1h1v-1h-1zM8 8.118a.5.5 0 01.757-.429l4 2.382a.5.5 0 010 .858l-4 2.382A.5.5 0 018 12.882V8.118z"
                        fill-rule="evenodd"
                      />
                    </svg>
                  </span>
                </button>
              </div>
              <div
                class="flex-1 flex items-center justify-center"
              >
                <div
                  class="w-5 border-t border-ash/30"
                />
              </div>
              <div
                class="flex flex-col items-center gap-1"
              >
                <button
                  aria-label="Tasks"
                  aria-pressed="false"
                  class="w-8 h-8 flex items-center justify-center transition-colors duration-150 text-silver hover:text-white hover:bg-ash/20"
                >
                  <span
                    class="w-4 h-4 block"
                  >
                    <div
                      class="relative w-4 h-4 flex-shrink-0 border-2 border-gold bg-gold/10"
                    >
                      <svg
                        class="absolute inset-0 w-full h-full p-0.5"
                        fill="none"
                        viewBox="0 0 16 16"
                      >
                        <path
                          class="text-gold"
                          d="M3 8l3 3 7-7"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                        />
                      </svg>
                    </div>
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="rounded-none relative transition-opacity duration-500 bg-charcoal shadow-sm border border-gold/30 p-6 space-y-4 md:col-span-2"
      >
        <h3
          class="text-gold font-medium"
        >
          ArtifactsPanel · cold-start loading
        </h3>
        <p
          class="text-sm text-silver"
        >
          Pass 
          <code>
            loading
          </code>
           as a boolean (e.g. via
           
          <code>
            ChatInterface.artifactsLoading
          </code>
          ) and the panel renders placeholder cards until real artifacts arrive — instead of the bare "No artifacts" empty state.
        </p>
        <div
          class="h-96 border border-ash/40 overflow-hidden"
        >
          <div
            class="h-full flex flex-col relative"
            data-testid="artifacts-panel"
          >
            <div
              class="flex items-center justify-between p-4 border-b border-ash/40 shrink-0"
            >
              <h3
                class="text-sm font-semibold text-white"
              >
                Artifacts
              </h3>
            </div>
            <div
              class="flex-1 overflow-auto relative"
              data-testid="artifacts-scroll-area"
            >
              <div>
                <div
                  class="p-4 space-y-4"
                  data-testid="artifacts-grid"
                >
                  <div
                    class="animate-pulse bg-ash w-full aspect-video"
                  />
                  <div
                    class="animate-pulse bg-ash w-full aspect-video"
                  />
                  <div
                    class="animate-pulse bg-ash w-full aspect-video"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
`;
